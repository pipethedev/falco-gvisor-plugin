    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "updater",
      "exe": "/usr/local/bin/updater",
      "argv": [
        "updater",
        "-i"
      ],
      "upper_layer": true,
      "stdin": "ipv4",
      "stdout": "ipv4"
    }
  ]
