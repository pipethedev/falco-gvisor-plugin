{
  "description": "An application process reads an SSH private key and cloud credentials (full profile).",
  "expect": [
    "gVisor Sensitive File Read"
  ],
  "events": [
    {
      "point": "sentry/execve",
      "pid": 1,
      "ppid": 0,
      "comm": "sh",
      "exe": "/bin/sh",
      "argv": [
        "/bin/sh"
      ],
      "lower_layer": true
    },
    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "exe": "/usr/bin/python3",
      "argv": [
        "python3",
        "steal.py"
      ],
      "lower_layer": true
    },
    {
      "point": "syscall/openat",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "path": "/root/.ssh/id_rsa",
      "flags": "O_RDONLY"
    },
    {
      "point": "syscall/openat",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "path": "/root/.aws/credentials",
      "flags": "O_RDONLY"
    }
  ]
}
