{
  "description": "Payload downloaded to /dev/shm and executed.",
  "expect": [
    "gVisor Dropped Binary Executed From Temp Directory"
  ],
  "events": [
    {
      "point": "sentry/execve",
      "pid": 1,
      "ppid": 0,
      "comm": "sh",
      "exe": "/bin/sh",
