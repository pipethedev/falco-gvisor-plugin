{
  "description": "Payload written to the rootfs /tmp (upper layer) and to /dev/shm (tmpfs, never upper layer in gVisor) and executed.",
  "expect": [
    "gVisor Dropped Binary Executed From Temp Directory"
  ],
  "events": [
    {
      "point": "sentry/execve",
      "pid": 1,
      "ppid": 0,
      "comm": "sh",
      "exe": "/bin/sh",
      "argv": [
        "/bin/sh"
      ]
    },
    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "update",
      "exe": "/tmp/update",
      "argv": [
        "/tmp/update"
      ],
      "upper_layer": true
    },
    {
      "point": "sentry/execve",
      "pid": 3,
      "ppid": 1,
      "comm": "update",
      "exe": "/dev/shm/.cache/update",
      "argv": [
        "/dev/shm/.cache/update"
      ]
    }
  ]
}
