{
  "description": "Payloads written at runtime and executed: /tmp on the tmpfs runsc mounts over an empty image /tmp (no layer flags), /var/tmp on the overlay upper layer, and /dev/shm (tmpfs). Layer flags as observed with real runsc.",
  "expect": [
    "gVisor Dropped Binary Executed From Temp Directory"
  ],
  "events": [
    {
      "point": "sentry/execve",
      "pid": 1,
      "ppid": 0,
      "comm": "sh",
      "exe": "/bin/sh",
      "argv": [
        "/bin/sh"
      ],
      "lower_layer": true
    },
    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "update",
      "exe": "/tmp/update",
      "argv": [
        "/tmp/update"
      ]
    },
    {
      "point": "sentry/execve",
      "pid": 3,
      "ppid": 1,
      "comm": "update",
      "exe": "/var/tmp/.x/update",
      "argv": [
        "/var/tmp/.x/update"
      ],
      "upper_layer": true
    },
    {
      "point": "sentry/execve",
      "pid": 4,
      "ppid": 1,
      "comm": "update",
      "exe": "/dev/shm/.cache/update",
      "argv": [
        "/dev/shm/.cache/update"
      ]
    }
  ]
}
