        "/bin/sh"
      ]
    },
    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "update",
      "exe": "/dev/shm/.cache/update",
      "argv": [
        "/dev/shm/.cache/update"
      ],
      "upper_layer": true
    }
  ]
}
