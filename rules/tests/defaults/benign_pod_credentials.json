{
  "description": "A Kubernetes client reads its service-account token and an AWS SDK fetches instance credentials from IMDS: routine, and silent with the shipped rule selection.",
  "expect": [],
  "events": [
    {
      "point": "sentry/execve",
      "pid": 1,
      "ppid": 0,
      "comm": "sh",
      "exe": "/bin/sh",
      "argv": [
        "/bin/sh"
      ],
      "lower_layer": true
    },
    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "exe": "/usr/bin/python3",
      "argv": [
        "python3",
        "app.py"
      ],
      "lower_layer": true
    },
    {
      "point": "syscall/openat",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "path": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "flags": "O_RDONLY"
    },
    {
      "point": "syscall/socket",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "domain": "AF_INET",
      "type": "SOCK_STREAM",
      "fd": 6
    },
    {
      "point": "syscall/connect",
      "pid": 2,
      "ppid": 1,
      "comm": "python3",
      "addr": "169.254.169.254:80",
      "fd": 6
    }
  ]
}
