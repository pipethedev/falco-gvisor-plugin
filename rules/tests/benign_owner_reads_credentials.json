{
  "description": "Tools reading their own credential files, and an image binary connecting out.",
  "expect": [],
  "events": [
    {
      "point": "sentry/execve",
      "pid": 1,
      "ppid": 0,
      "comm": "sh",
      "exe": "/bin/sh",
      "argv": [
        "/bin/sh"
      ],
      "lower_layer": true
    },
    {
      "point": "sentry/execve",
      "pid": 2,
      "ppid": 1,
      "comm": "ssh",
      "exe": "/usr/bin/ssh",
      "argv": [
        "ssh",
        "git@example.com"
      ],
      "lower_layer": true
    },
    {
      "point": "syscall/openat",
      "pid": 2,
      "ppid": 1,
      "comm": "ssh",
      "path": "/root/.ssh/id_ed25519",
      "flags": "O_RDONLY"
    },
    {
      "point": "sentry/execve",
      "pid": 3,
      "ppid": 1,
      "comm": "kubectl",
      "exe": "/usr/bin/kubectl",
      "argv": [
        "kubectl",
        "get",
        "pods"
      ],
      "lower_layer": true
    },
    {
      "point": "syscall/openat",
      "pid": 3,
      "ppid": 1,
      "comm": "kubectl",
      "path": "/root/.kube/config",
      "flags": "O_RDONLY"
    },
    {
      "point": "sentry/execve",
      "pid": 4,
      "ppid": 1,
      "comm": "app",
      "exe": "/usr/local/bin/app",
      "argv": [
        "app"
      ],
      "lower_layer": true
    },
    {
      "point": "syscall/connect",
      "pid": 4,
      "ppid": 1,
      "comm": "app",
      "addr": "10.0.0.5:5432"
    }
  ]
}
